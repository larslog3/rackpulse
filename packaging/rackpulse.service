[Unit]
Description=RackPulse Homelab IPAM & Ansible Inventory Studio
After=network.target

[Service]
Type=simple
WorkingDirectory=/usr/share/rackpulse
Environment="PORT=8080"
Environment="DATA_DIR=/var/lib/rackpulse"
ExecStart=/usr/bin/python3 /usr/share/rackpulse/server.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
