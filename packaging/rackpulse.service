[Unit]
Description=RackPulse Homelab IPAM & Ansible Inventory Studio
After=network.target

[Service]
Type=simple
WorkingDirectory=/usr/share/rackpulse
Environment="RACKPULSE_PORT=8080"
Environment="RACKPULSE_BIND=0.0.0.0"
ExecStart=/usr/bin/python3 /usr/share/rackpulse/server.py --port 8080
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
